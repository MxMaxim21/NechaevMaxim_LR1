<Page x:Class="Calculator.Views.History"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Calculator.Views"
      mc:Ignorable="d" 
      Background="{DynamicResource PrimaryBackground}"
      Title="History">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="История операций" Style="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0, 0, 0, 15"/>

        <ListBox Grid.Row="1" x:Name="historyList" Foreground="{DynamicResource TextForeground}" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="5" Foreground="Black"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 15, 0, 0">
            <Button Content="Очистить" Name="BtnClear" Click="BtnClear_Click" Style="{StaticResource ButtonTwo}"/>
            <Button Content="Назад" Name="BtnBack" Click="BtnBack_Click" Style="{StaticResource ButtonThree}"/>
        </StackPanel>
    </Grid>
</Page>
