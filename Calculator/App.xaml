<Application x:Class="Calculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Calculator"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="PrimaryBackground" Color="OldLace"/>
        <SolidColorBrush x:Key="TextForeground" Color="BurlyWood"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="SandyBrown"/>
        <SolidColorBrush x:Key="ButtonBackgroundTwo" Color="Peru"/>
        <SolidColorBrush x:Key="ButtonBackgroundHover" Color="DarkSalmon"/>

        <Style TargetType="Page">
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
        </Style>

        <!--TextBlock-->

        <Style TargetType="TextBlock" x:Key="TextMain">
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="30"></Setter>
            <Setter Property="FontFamily" Value="Segoe UI Variable"></Setter>
        </Style>

        <!--Button-->

        <Style TargetType="Button" x:Key="ButtonMain">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ButtonTwo" BasedOn="{StaticResource ButtonMain}">
            <Setter Property="Background" Value="#34495E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6c8eb2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ButtonThree" BasedOn="{StaticResource ButtonMain}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundTwo}"/>
        </Style>

        <!--TextBox-->

        <Style TargetType="TextBox" x:Key="TextBoxMain">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
        </Style>

    </Application.Resources>
</Application>
